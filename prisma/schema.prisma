datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  // id String @id @default(auto()) @map("_id") @db.ObjectId
  id String @id @default(uuid())

  name              String
  username          String
  email             String    @unique
  password          String
  address           String?
  contact           String?
  avatar            String?
  status            String
  token             String?
  tokenValidityDate DateTime?
  salt              String
  twoFASecret       String?
  twoFAThrottleTime DateTime?
  isTwoFAEnabled    Boolean   @default(false)
  skipHashPassword  Boolean   @default(false)
  role              Role      @relation(fields: [roleId], references: [id])
  roleId String

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt


  @@map("users")
}
model Role {
  id String @id @default(uuid())

  name        String @unique
  description String

  permissions        Permission[]
  // PermissionsOnRoles PermissionsOnRoles[]
  User               User[]

  @@map("roles")
}

model Permission {
  id String @id @default(uuid())

  resource    String
  description String  @unique
  path        String
  method      String
  isDefault   Boolean @default(false)

  roles              Role[] 
  // PermissionsOnRoles PermissionsOnRoles[]

  @@map("permissions")
}


