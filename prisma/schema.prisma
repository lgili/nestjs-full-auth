model EmailTemplate {
  id String @id @default(uuid())

  title     String  @unique
  slug      String  @unique
  sender    String
  subject   String
  body      String
  isDefault Boolean

  @@map("emailsTemplate")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  ip        String
  userAgent String
  browser   String?
  os        String?
  isRevoked Boolean
  expires   DateTime

  @@map("tokens")
}
