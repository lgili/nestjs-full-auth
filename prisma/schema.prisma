datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  // id String @id @default(auto()) @map("_id") @db.ObjectId
  id String @id @default(uuid())

  name              String
  username          String    @unique
  email             String    @unique
  password          String
  address           String?
  contact           String?
  avatar            String?
  status            String
  token             String? @unique
  tokenValidityDate DateTime?
  salt              String
  twoFASecret       String? 
  twoFAThrottleTime DateTime?
  isTwoFAEnabled    Boolean   @default(false)
  skipHashPassword  Boolean   @default(false)
  role              Role      @relation(fields: [roleId], references: [id])
  roleId String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt


  @@map("users")
}
model Role {
  id String @id @default(uuid())

  name        String @unique
  description String

  permissions        Permission[]
  User               User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("roles")
}

model Permission {
  id String @id @default(uuid())

  resource    String
  description String  @unique
  path        String
  method      String
  isDefault   Boolean @default(false)

  roles              Role[] 
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  
  @@map("permissions")
}


model EmailTemplate {
  id String @id @default(uuid())

  title     String  @unique
  slug      String  @unique
  sender    String
  subject   String
  body      String
  isDefault Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("emailsTemplate")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  ip        String
  userAgent String
  browser   String?
  os        String?
  isRevoked Boolean
  expires   DateTime

  @@map("tokens")
}
