datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id String @id @default(auto()) @map("_id") @db.ObjectId // mongo
  // id String @id @default(uuid()) // others

  name              String
  username          String    @unique
  email             String    @unique
  password          String
  address           String?
  contact           String?
  avatar            String?
  status            String
  token             String?   @unique
  tokenValidityDate DateTime?
  salt              String
  twoFASecret       String?
  twoFAThrottleTime DateTime?
  isTwoFAEnabled    Boolean   @default(false)
  skipHashPassword  Boolean   @default(false)

  createdAt DateTime? @default(now())
  updatedAt DateTime? @default(now()) @updatedAt
  role      Role?    @relation(fields: [roleId], references: [id])
  roleId    String?  @db.ObjectId

  @@map("users")
}

model Role {
  id String @id @default(auto()) @map("_id") @db.ObjectId // mongo
  // id String @id @default(uuid()) // others

  name        String @unique
  description String

  // mongo
  permissionIDs String[]     @db.ObjectId
  permissions   Permission[] @relation(fields: [permissionIDs], references: [id])

  // others
  // permissions Permission[]
  user User[]

  createdAt DateTime? @default(now())
  updatedAt DateTime? @default(now()) @updatedAt

  @@map("roles")
}

model Permission {
  id String @id @default(auto()) @map("_id") @db.ObjectId // mongo
  // id String @id @default(uuid()) // others

  resource    String
  description String  @unique
  path        String
  method      String
  isDefault   Boolean @default(false)

  // mongo
  roleIDs String[] @db.ObjectId
  roles   Role[]   @relation(fields: [roleIDs], references: [id])

  // others
  // roles     Role[]
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("permissions")
}

model EmailTemplate {
  id String @id @default(auto()) @map("_id") @db.ObjectId // mongo
  // id String @id @default(uuid()) // others

  title     String  @unique
  slug      String  @unique
  sender    String
  subject   String
  body      String
  isDefault Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("emailsTemplate")
}

model RefreshToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId // mongo
  // id String @id @default(uuid()) // others
  userId    String
  ip        String
  userAgent String
  browser   String?
  os        String?
  isRevoked Boolean
  expires   DateTime

  @@map("tokens")
}
